---

<div
  id="cursor"
  class="pointer-events-none fixed inset-0 z-[90] hidden opacity-0 transition-opacity duration-300"
  aria-hidden="true"
>
  <div
    id="cursor-ring"
    class="absolute left-0 top-0 grid size-10 place-items-center rounded-full border border-ink/35 transition-[width,height,background-color,border-color] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
  >
    <span
      id="cursor-label"
      class="scale-75 text-[0.5rem] font-semibold uppercase tracking-[0.2em] text-ink opacity-0 transition duration-300"
    ></span>
  </div>
  <div id="cursor-dot" class="absolute left-0 top-0 size-1.5 rounded-full bg-ink"></div>
</div>

<style>
  @media (hover: hover) and (pointer: fine) {
    #cursor {
      display: block;
    }
  }
</style>
