---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projetos: CollectionEntry<'projetos'>[];
}
const { projetos } = Astro.props;
---

<div class="relative" data-project-index>
  <div
    data-project-preview
    aria-hidden="true"
    class="pointer-events-none fixed left-0 top-0 z-30 hidden aspect-[4/3] w-[24rem] overflow-hidden opacity-0 lg:block"
  >
    {
      projetos.map((projeto, i) => (
        <img
          data-preview-src={projeto.data.capa}
          alt=""
          width="1200"
          height="1080"
          decoding="async"
          data-preview-slide={i}
          class="absolute inset-0 size-full object-cover opacity-0"
        />
      ))
    }
  </div>

  <ul class="border-t border-current/15">
    {
      projetos.map((projeto, i) => (
        <li class="border-b border-current/15">
          <a
            href={`/projetos/${projeto.id}`}
            data-cursor="view"
            data-project-row={i}
            class="group grid grid-cols-1 items-center gap-4 py-7 transition-opacity duration-500 md:grid-cols-[4rem_1fr_auto] md:gap-8 md:py-9"
          >
            <span class="eyebrow opacity-40">{String(i + 1).padStart(2, '0')}</span>

            <div class="flex flex-col gap-3 md:flex-row md:items-baseline md:gap-6">
              <h3 class="display-md transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] md:group-hover:translate-x-4">
                {projeto.data.titulo}
              </h3>
              <span class="text-sm font-light opacity-50">{projeto.data.segmento}</span>
            </div>

            <div class="flex items-center gap-6">
              <span class="hidden text-[0.6875rem] uppercase tracking-[0.18em] opacity-40 lg:block">
                {projeto.data.servicos.join(' / ')}
              </span>
              <span class="eyebrow opacity-40">{projeto.data.ano}</span>
            </div>

            <img
              src={projeto.data.capa}
              alt={`Identidade visual do projeto ${projeto.data.titulo}`}
              width="1200"
              height="1080"
              loading="lazy"
              decoding="async"
              class="aspect-[16/10] w-full object-cover md:hidden"
            />
          </a>
        </li>
      ))
    }
  </ul>
</div>
