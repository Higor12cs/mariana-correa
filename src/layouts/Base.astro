---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Cursor from '../components/Cursor.astro';
import Preloader from '../components/Preloader.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  titulo: string;
  descricao?: string;
  imagem?: string;
  intro?: boolean;
}

const { titulo, descricao = site.descricao, imagem = '/img/og.webp', intro = false } = Astro.props;

const tituloCompleto = titulo === site.nome ? `${site.nome} — ${site.papel}` : `${titulo} — ${site.nome}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagemAbsoluta = new URL(imagem, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonica} />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <meta name="author" content={site.nome} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagemAbsoluta} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-jakarta" preload />
  </head>

  <body>
    {intro && <Preloader />}
    <Cursor />
    <Header />

    <main id="conteudo">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
