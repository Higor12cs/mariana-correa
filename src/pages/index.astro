---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Slashes from '../components/Slashes.astro';
import Marquee from '../components/Marquee.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import HorizontalGallery from '../components/HorizontalGallery.astro';
import { numeros, redesPublicadas, servicos, site } from '../data/site';
import { grafoBase, pessoa, rota, website } from '../data/jsonld';

const projetos = (await getCollection('projetos', ({ data }) => !data.rascunho)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);

const especialidades = ['Branding', 'Identidade Visual', 'Naming', 'Direção Criativa', 'Estratégia'];

const pecas = projetos.flatMap((projeto) =>
  [projeto.data.imagemIntro, ...projeto.data.galeria.map((g) => g.src)]
    .filter((src): src is string => Boolean(src))
    .map((src) => ({
      src,
      alt: `Aplicações da marca ${projeto.data.titulo}`,
      titulo: projeto.data.titulo,
      legenda: projeto.data.segmento,
    })),
);
---

<Base
  titulo={site.nome}
  intro
  tipo="profile"
  dadosEstruturados={grafoBase([
    pessoa,
    website,
    {
      '@type': 'ProfilePage',
      '@id': `${site.url}/#pagina`,
      url: rota('/'),
      name: `${site.nome} — ${site.papel}`,
      isPartOf: { '@id': website['@id'] },
      about: { '@id': pessoa['@id'] },
      inLanguage: 'pt-BR',
    },
  ])}
>
  <section
    id="topo"
    class="relative flex min-h-svh flex-col justify-between overflow-hidden pb-12 pt-24"
  >
    <div class="pointer-events-none absolute inset-0 overflow-hidden" data-parallax="70">
      <div
        data-blob
        class="glow left-1/2 top-1/2 size-[46vw] min-h-[22rem] min-w-[22rem] -translate-x-1/2 -translate-y-1/2"
      >
      </div>
      <div
        data-blob
        class="glow left-[38%] top-[58%] size-[30vw] min-h-[15rem] min-w-[15rem] -translate-x-1/2 -translate-y-1/2 opacity-70"
      >
      </div>
    </div>

    <div class="shell relative z-10" data-reveal="hero">
      <div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
        <div
          class="reveal-line font-display text-[clamp(1.5rem,3.4vw,2.75rem)] font-medium tracking-tight"
        >
          <span class="flex">MARIANA<span class="text-lime">//</span>CORRÊA</span>
        </div>
        <div class="reveal-line eyebrow opacity-55">
          <span>{site.papel}</span>
        </div>
      </div>
      <div class="mt-5 rule"></div>
    </div>

    <div class="shell relative z-10 flex items-end justify-between gap-8" data-reveal="hero">
      <h1
        class="max-w-[20ch] font-display text-[clamp(2rem,5.6vw,5.25rem)] font-light leading-[1.04] tracking-[-0.04em]"
      >
        <span class="reveal-line"><span>O próximo nível da</span></span>
        <span class="reveal-line"><span>sua marca começa</span></span>
        <span class="reveal-line"><span>onde o óbvio termina.</span></span>
      </h1>
      <Slashes class="mb-3 hidden h-[clamp(3rem,7vw,7rem)] w-auto shrink-0 sm:block" />
    </div>
  </section>

  <section class="bg-ink py-28 text-paper md:py-40" data-theme="escuro">
    <div class="shell grid gap-14 lg:grid-cols-[1fr_1.1fr] lg:gap-24" data-reveal>
      <div>
        <div class="flex flex-wrap gap-x-10 gap-y-8">
          {
            numeros.map((numero) => (
              <div class="fade-up">
                <span class="block font-display text-[clamp(2.25rem,4vw,3.5rem)] font-light leading-none tracking-tighter">
                  {numero.valor}
                </span>
                <span class="mt-2 block text-[0.6875rem] uppercase tracking-[0.18em] text-paper/40">
                  {numero.rotulo}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <h2 class="display-md">
          <span class="reveal-line"
            ><span>Criando marcas <em class="not-italic text-lime">disruptivas</em></span></span
          >
          <span class="reveal-line"><span>e inconfundíveis na percepção.</span></span>
        </h2>
        <div class="mt-10 max-w-xl space-y-5 text-base font-light leading-relaxed text-paper/60">
          <p class="fade-up">
            Acredito que marcas relevantes são construídas a partir de uma visão clara de negócio,
            estratégia e uma relação próxima com quem está por trás delas. Meu trabalho parte do
            entendimento da essência e dos objetivos de cada negócio para transformar posicionamento
            em uma expressão de marca consistente, distinta e capaz de gerar valor.
          </p>
        </div>
        <a
          href="/sobre"
          data-cursor="link"
          class="fade-up mt-10 inline-flex items-center gap-3 border-b border-lime pb-1 text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-lime"
        >
          Conheça a trajetória
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <div class="border-y border-ink/10 bg-lime py-5 text-ink">
    <Marquee itens={especialidades} velocidade={1} />
  </div>

  <section id="projetos" class="py-24 md:py-36">
    <div class="shell" data-reveal>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <span class="eyebrow fade-up opacity-45">Selecionados</span>
          <h2 class="display-lg mt-5">
            <span class="reveal-line"><span>Projetos</span></span>
          </h2>
        </div>
        <a
          href="/projetos"
          data-cursor="link"
          class="fade-up border-b border-ink/25 pb-1 text-[0.6875rem] font-medium uppercase tracking-[0.22em] transition-colors hover:border-lime"
        >
          Ver todos ({projetos.length})
        </a>
      </div>

      <div class="mt-14">
        <ProjectIndex projetos={projetos} />
      </div>
    </div>
  </section>

  <HorizontalGallery
    eyebrow="Da estratégia à aplicação"
    titulo="A marca fora do papel"
    pecas={pecas}
  />

  <section class="bg-ink py-24 text-paper md:py-36" data-theme="escuro">
    <div class="shell" data-reveal>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 class="display-lg">
          <span class="reveal-line"><span>Serviços</span></span>
        </h2>
      </div>

      <dl class="mt-16 border-t border-paper/15">
        {
          servicos.map((servico) => (
            <div class="fade-up grid gap-6 border-b border-paper/15 py-10 md:grid-cols-[5rem_1fr_1.1fr] md:gap-10">
              <dt class="eyebrow text-lime">{servico.numero}</dt>
              <dd class="display-md">{servico.titulo}</dd>
              <dd class="space-y-5">
                <p class="text-base font-light leading-relaxed text-paper/55">{servico.descricao}</p>
                <ul class="flex flex-wrap gap-2">
                  {servico.itens.map((item) => (
                    <li class="rounded-full border border-paper/20 px-3 py-1.5 text-[0.6875rem] uppercase tracking-[0.14em] text-paper/50">
                      {item}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="py-24 md:py-36">
    <div class="shell grid items-center gap-12 lg:grid-cols-[0.55fr_1fr] lg:gap-20" data-reveal>
      <div
        class="relative aspect-[3/4] w-full max-w-xs overflow-hidden bg-ink/5 lg:max-w-sm"
        data-img
      >
        <img
          src="/img/mariana-retrato.webp"
          alt="Retrato de Mariana Corrêa"
          width="507"
          height="793"
          loading="lazy"
          decoding="async"
          class="size-full object-cover"
        />
      </div>

      <div>
        <span class="eyebrow fade-up opacity-45">Sobre</span>
        <h2 class="display-md mt-6">
          <span class="reveal-line"><span>Publicitária,</span></span>
          <span class="reveal-line"><span>Estrategista de Marca</span></span>
          <span class="reveal-line"><span>e Diretora de Arte.</span></span>
        </h2>
        <div class="mt-8 max-w-lg space-y-5 text-base font-light leading-relaxed opacity-65">
          <p class="fade-up">
            Com mais de 6 anos de experiência em design, branding, marketing e comunicação, minha
            trajetória começou no design e evoluiu para uma atuação cada vez mais estratégica,
            desenvolvendo identidades visuais, projetos de branding, campanhas e sistemas de
            comunicação para marcas de diferentes segmentos e momentos de negócio.
          </p>
          <p class="fade-up">
            Passei por agências, projetos independentes e também pela experiência de cofundar e
            participar da gestão de uma agência de marketing, ampliando minha visão sobre clientes,
            negócios, processos e liderança.
          </p>
          <p class="fade-up">
            Hoje, meu trabalho está na interseção entre estratégia e criação: entender o que uma
            marca precisa representar, construir seu posicionamento e traduzir isso em uma
            identidade consistente, relevante e capaz de gerar valor.
          </p>
        </div>
        <a
          href="/sobre"
          data-cursor="link"
          class="fade-up mt-10 inline-flex items-center gap-3 border-b border-ink/25 pb-1 text-[0.6875rem] font-medium uppercase tracking-[0.22em] transition-colors hover:border-lime"
        >
          Ler mais
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section id="contato" class="relative overflow-hidden bg-ink pb-16 pt-28 text-paper md:pb-24 md:pt-44" data-theme="escuro">
    <div
      data-blob
      class="glow left-1/2 top-[58%] size-[40vw] min-h-[20rem] min-w-[20rem] -translate-x-1/2 -translate-y-1/2 opacity-70"
    >
    </div>

    <div class="shell relative" data-reveal>
      <span class="eyebrow fade-up text-lime">Contato</span>

      <h2 class="display-lg mt-8 max-w-4xl">
        <span class="reveal-line"><span>Vamos construir</span></span>
        <span class="reveal-line"><span>algo consistente?</span></span>
      </h2>

      <a
        href={`mailto:${site.email}`}
        data-cursor="view"
        class="fade-up mt-12 inline-block font-display text-[clamp(1.25rem,3.5vw,2.75rem)] font-light tracking-tight underline decoration-lime decoration-1 underline-offset-8 transition-colors hover:text-lime"
      >
        {site.email}
      </a>

      <div class="mt-14 flex flex-wrap gap-x-8 gap-y-3">
        {
          redesPublicadas.map((rede) => (
            <a
              href={rede.url}
              target="_blank"
              rel="noopener noreferrer"
              data-cursor="link"
              class="fade-up text-[0.6875rem] font-medium uppercase tracking-[0.22em] text-paper/50 transition-colors hover:text-lime"
            >
              {rede.nome}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
